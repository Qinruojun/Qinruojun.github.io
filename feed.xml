---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel><title>{{ site.title | xml_escape }}</title><link>{{ site.url }}/</link><description>{{ site.description | xml_escape }}</description><language>zh-CN</language>{% assign entries = site.blog | concat: site.papers | where_exp: 'note', 'note.published != false' | sort: 'date' | reverse %}{% for note in entries %}<item><title>{{ note.title | xml_escape }}</title><link>{{ note.url | absolute_url }}</link><guid>{{ note.url | absolute_url }}</guid><pubDate>{{ note.date | date_to_rfc822 }}</pubDate><description>{{ note.summary | xml_escape }}</description></item>{% endfor %}</channel></rss>
